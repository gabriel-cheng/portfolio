<main id="main-sendmail">
    <div class="sendmail-title">
        <h1>Enviar e-mail</h1>
    </div>
    <form action="/congratulations" method="post">
        <div class="name-area">
            <label for="input-name">Nome</label>
            <input type="text" name="name" id="input-name" placeholder="Informe o seu nome" required>
        </div>
        <div class="email-area">
            <label for="input-email">Email</label>
            <input type="email" name="email" id="input-email" placeholder="ex: meunome@outlook.com" required>
        </div>
        <div class="phone-area">
            <label for="phone">Número para contato</label>
            <input type="tel" id="phone" name="phone" value="+55 (__) _____ - ____" mask="+55 (__) _____ - ____" placeholder="+55 (__) _____ - ____" required/>
        </div>
        <div class="text-area">
            <label for="textarea">Mensagem</label>
            <textarea name="message" id="textarea" rows="10" required></textarea>
        </div>
        <div class="submit-area">
            <input id="sendmail-submit" type="submit" value="Enviar">
        </div>
    </form>
</main>

<style>
    #main-sendmail {
        margin: 20vh 0 5vh 0;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
    }
    .sendmail-title {
        margin: 0 0 3% 0;
        font-size: 2rem;
    }
    #main-sendmail form {
        width: 80vw;
        display: grid;
        grid-template-columns: auto;
        justify-items: center;
        grid-template-areas:
            'name'
            'email'
            'phone'
            'mensagem'
        ;
    }
    .name-area {
        grid-area: name;
    }
    .email-area {
        grid-area: email;
    }
    .phone-area {
        grid-area: phone;
    }
    .text-area {
        grid-area: mensagem;
    }
    .name-area,
    .email-area,
    .phone-area,
    .text-area {
        max-width: 600px;
        width: 100%;
        min-width: 432px;
    }
    .name-area label,
    .email-area label,
    .phone-area label,
    .text-area label {
        display: block;
        font-size: 1.4rem;
    }
    input[type=text],
    input[type=email],
    input[type=tel] {
        width: 100%;
        padding: 0 0 0 10px;
        background-color: rgb(0, 0, 0, 0) !important;
        border: 0;
        border-bottom: 1px solid black;
        margin: 0 0 15px 0;
        text-transform: initial;
        font-size: 1.6rem;
    }
    textarea {
        text-transform: initial;
        font-size: 1.6rem;
    }
    input[type=text]::placeholder,
    input[type=email]::placeholder {
        font-family: 'gabriel';
    }
    input[type=text]:focus,
    input[type=email]:focus,
    input[type=tel]:focus,
    textarea:focus {
        outline: 0;
    }
    textarea:focus {
        outline: 1px solid black;
    }
    textarea {
        width: 100%;
        padding: 5px;
    }
    textarea:focus-visible {
        border: 0;
    }
    .submit-area input {
        max-width: 600px;
        width: 100%;
        min-width: 432px;
        height: 80px;
        margin: 8% 0 0 0;
        cursor: pointer;
        background-color: rgba(0, 0, 0, 0.212);
        border: 0;
        transition: 0.2s ease-in-out;
    }
    .submit-area input:hover {
        background-color: rgba(107, 107, 107, 0.678);
        transition: 0.2s ease-in-out;
    }
    @media screen and (max-width: 540px) {
        .name-area,
        .email-area,
        .phone-area,
        .text-area {
            width: 100%;
            min-width: 256px;
        }
        .submit-area, .submit-area input {
            max-width: 432px;
            width: 100%;
            min-width: 200px;
        }
    }
</style>
