<main id="main-sendmail">
    <div class="sendmail-title">
        <h1>Enviar e-mail</h1>
    </div>
    <form action="/congratulations" method="post">
        <div class="name-area">
            <label for="input-name">Nome</label>
            <input type="text" name="name" id="input-name" placeholder="Informe o seu nome" required>
        </div>
        <div class="email-area">
            <label for="input-email">Email</label>
            <input type="email" name="email" id="input-email" placeholder="ex: meunome@outlook.com" required>
        </div>
        <div class="phone-area">
            <label for="phone">Número para contato</label>
            <input type="tel" id="phone" name="phone" value="+55 (__) _____ - ____" mask="+55 (__) _____ - ____" placeholder="+55 (__) _____ - ____" required/>
        </div>
        <div class="text-area">
            <label for="textarea">Mensagem</label>
            <textarea name="message" id="textarea" rows="10" required></textarea>
        </div>
        <div class="submit-area">
            <input id="sendmail-submit" type="submit" value="Enviar">
        </div>
    </form>
</main>