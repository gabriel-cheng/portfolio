    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portfolio | Gabriel Carvalho</title>
    <link rel="shortcut icon" href="/images/icons/portfolio-icon-preto.png" type="image/x-icon">
    <link rel="stylesheet" href="/css/default.css">
</head>
<body>
    <button onclick="backToTop();" id="btn-top">
        <img src="/images/icons/preto/top.png" alt="botão seta pra cima">
    </button>

    {{> header}}

    {{{ body }}}

    {{> footer}}

<script src="/scripts/darkmode.js"></script>
<script src="/scripts/send-email.js"></script>
<script src="/scripts/phonemask.min.js"></script>
<script>const cssPhone = 'input[name="phone"'; (new phoneMask()).init(cssPhone);</script>
<script src="https://kit.fontawesome.com/84c556e9ab.js" crossorigin="anonymous"></script>
<script src="/scripts/get-date-script.js"></script>
<script src="/scripts/menu-toggle.js"></script>
<script>
    window.onscroll = function() {
        scroll();
    }
    function scroll() {
        const btn = document.querySelector('#btn-top');
        const width = window.screen.width;

        if(document.documentElement.scrollTop > 300 && width > 760) {
            btn.style.display = "block";
        }
        else {
            btn.style.display = "none";
        }
    }

    function backToTop() {
        document.documentElement.scrollTop = 0;
    }
</script>
</body>
</html>
